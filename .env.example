SHOPIFY_STORE_DOMAIN=example.myshopify.com # Hostname only; server-only
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpca_example_storefront_access_token_1234567890 # Shopify Storefront API token string; server-only
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_example_admin_access_token_1234567890 # Shopify Admin API access token string; server-only
SHOPIFY_API_VERSION=2026-01 # Shopify API version in YYYY-MM format; server-only
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/ourcoordinates # Full database connection URL; server-only
